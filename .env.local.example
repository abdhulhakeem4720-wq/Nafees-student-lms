# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to client

# Email sending (used for registration confirmation + admin batch messages)
# Sign up at https://resend.com (free tier is fine to start)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="Student Register System <no-reply@yourdomain.com>"

# Optional: if/when you add a real payment gateway (PayHere is common for LK)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
